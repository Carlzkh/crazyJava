<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.crazyjava.mapper.UserMapper">

    <!-- ===== 查询所有用户 ===== -->
    <select id="findAll" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user where is_deleted=0
    </select>

    <!-- ===== 根据 ID 查询用户 ===== -->
    <select id="findById" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user WHERE id = #{id} and is_deleted=0
    </select>
    <!-- ===== 根据 ID 查询用户 ===== -->
    <select id="findById_" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user WHERE id = #{id}
    </select>
    <!-- ===== 按姓名模糊查询（支持动态条件） ===== -->
    <select id="findByName" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            and is_deleted=0
        </where>
    </select>

    <!-- ===== 按年龄范围查询（支持动态条件） =====
    在 XML 文件中，< 和 > 是特殊字符，会被 XML 解析器误认为是标签的开始或结束，所以不能直接使用。
    符号      转义写法
    >       &gt;
    >=      &gt;=
    <       &lt;
    <=      &lt;=
    &	    &amp;
    "	    &quot;
    '	    &apos;
    -->

    <select id="findByAge" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user
        <where>
            <if test="minAge != null and minAge != ''">
                AND age &gt; #{minAge}
            </if>
            <if test="maxAge != null and maxAge != ''">
                AND age &lt; #{maxAge}
            </if>
            and is_deleted=0
        </where>
    </select>

    <select id="searchUsers" resultType="com.example.crazyjava.entity.User">
        SELECT * FROM user
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="minAge != null">
                AND age &gt;= #{minAge}
            </if>
            <if test="maxAge != null">
                AND age &lt;= #{maxAge}
            </if>
            <if test="gender != null">
                AND gender = #{gender}
            </if>
            <if test="startDate != null and startDate != ''">
                AND create_time &gt;= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND create_time &lt;= #{endDate}
            </if>
            and is_deleted=0
        </where>
        ORDER BY id DESC
    </select>

    <!-- ===== 插入用户 ===== -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(name, age, gender, create_time, update_time,is_deleted) VALUES(#{name}, #{age},#{gender},now(),now(),0)
    </insert>

    <!-- ===== 更新用户 ===== -->
    <update id="setById">
        UPDATE user
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="age != null">
                age = #{age},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
        </set>
        WHERE id = #{id} and is_deleted=0
    </update>

    <!-- ===== 删除用户 ===== -->
    <update id="deleteById">
        update user set is_deleted=1 WHERE id = #{id} and is_deleted=0
    </update>
    <update id="deleteByIds">
        update user set is_deleted=1 WHERE id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
         and is_deleted=0
    </update>

</mapper>